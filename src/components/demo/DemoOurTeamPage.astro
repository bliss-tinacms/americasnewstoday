---
import { tinaField } from '@tinacms/astro/tina-field';
const { data = null } = Astro.props;
const block = Array.isArray(data?.blocks) ? data.blocks[0] : data;
const hero=block?.hero||{}; const leadership=block?.leadership||{}; const seniorStaff=block?.seniorStaff||{};
const people=Array.isArray(leadership?.people)?leadership.people:[]; const t=(v:any,f='')=>v??f;
---
<main class="ffn-demo ffn-demo-team"><header class="ph"><div class="w"><div class="ph-in"><div class="ph-kick"><i></i><span data-tina-field={hero?tinaField(hero,'eyebrow'):undefined}>{t(hero.eyebrow,'The Masthead')}</span></div><h1 data-tina-field={hero?tinaField(hero,'headline'):undefined}>{t(hero.headline,'The journalists behind the reporting.')}</h1><p data-tina-field={hero?tinaField(hero,'lede'):undefined}>{t(hero.lede,'America’s News Today is published by Scott Coleman and edited by Catherine Palmer. The senior editorial staff are listed below.')}</p></div></div></header><section class="ros"><div class="w"><div class="ros-h"><div><div class="ros-eye"><i></i><span data-tina-field={leadership?tinaField(leadership,'eyebrow'):undefined}>{t(leadership.eyebrow,'Who we are')}</span></div><div class="ros-t" data-tina-field={leadership?tinaField(leadership,'title'):undefined}>{t(leadership.title,'The Masthead')}</div></div><div class="ros-c">{people.length} editors · Four cities</div></div><div class="ros-l">{people.map((p:any,index:number)=><a href={`#p${index+1}`} class="rr"><div class="rr-n">{String(index+1).padStart(2,'0')}</div><div class="rr-nm" data-tina-field={tinaField(p,'name')}>{p.name}</div><div class="rr-rl" data-tina-field={tinaField(p,'role')}>{p.role}</div><div class="rr-lc" data-tina-field={tinaField(p,'location')}>{p.location}</div></a>)}</div></div></section><div class="pf">{people.map((p:any,index:number)=><section id={`p${index+1}`} class="pf-r"><div class="w"><div class="pf-in">{index%2===0&&<img class="pf-img" src={p.image} alt={p.imageAlt||p.name} data-tina-field={tinaField(p,'image')} />}<div><div class="pf-idx"><i></i><span>{String(index+1).padStart(2,'0')} · <span data-tina-field={tinaField(p,'role')}>{p.role}</span></span></div><div class="pf-n" data-tina-field={tinaField(p,'name')}>{p.name}</div><div class="pf-meta"><span data-tina-field={tinaField(p,'location')}>{p.location}</span><span>Editorial leadership</span><span>Newsroom</span></div><p class="pf-q" data-tina-field={tinaField(p,'bio')}>{p.bio}</p><p class="pf-x" data-tina-field={tinaField(p,'bio')}>{p.bio}</p></div>{index%2===1&&<img class="pf-img" src={p.image} alt={p.imageAlt||p.name} data-tina-field={tinaField(p,'image')} />}</div></div></section>)}</div><section class="jn"><div class="w"><div class="jn-in"><div><div class="jn-eye"><i></i><span data-tina-field={seniorStaff?tinaField(seniorStaff,'eyebrow'):undefined}>{t(seniorStaff.eyebrow,'Work with us')}</span></div><h2 data-tina-field={seniorStaff?tinaField(seniorStaff,'title'):undefined}>{t(seniorStaff.title,'We commission freelance reporting.')}</h2><p>If you have original reporting that fits one of our desks, send a short pitch describing what you have, who you have talked to, and what documents you hold.</p></div><div class="jn-r"><a href="mailto:editorial@americasnewstoday.org" class="jn-cta">Pitch the newsroom →</a></div></div></div></section></main>
