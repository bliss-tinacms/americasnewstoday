---
import { tinaField } from '@tinacms/astro/tina-field';
import { getBlogPermalink } from '../lib/permalinks';
import type { CmsBlog, CmsConfig } from '../lib/data';

type Post = CmsBlog;

interface Props {
  posts: Post[];
  config?: CmsConfig | null;
  data?: any;
  editData?: any;
}

const { posts, data, editData } = Astro.props;
const homepageBlocks = Array.isArray(data?.blocks) ? data.blocks : [];
const editHomepageBlocks = Array.isArray(editData?.blocks) ? editData.blocks : [];
const isHomepageTemplateBlock = (block: any) =>
  block?._template === 'homepageTemplate' || block?.__typename === 'PageBlocksHomepageTemplate';
const homepage = homepageBlocks.find(isHomepageTemplateBlock) ?? data?.homepage ?? {};
const teamBlock = homepageBlocks.find((block: any) => block?._template === 'ourTeamMockup17' || block?.__typename === 'PageBlocksOurTeamMockup17') ?? {};
const editHomepage = editHomepageBlocks.find(isHomepageTemplateBlock) ?? editData?.homepage ?? homepage;
const editTeamBlock = editHomepageBlocks.find((block: any) => block?._template === 'ourTeamMockup17' || block?.__typename === 'PageBlocksOurTeamMockup17') ?? teamBlock;

function tf(node: any, key: string) {
  try {
    return node ? tinaField(node, key) : undefined;
  } catch (_error) {
    return undefined;
  }
}

function value<T>(input: T | null | undefined, fallback: T): T {
  return input === null || input === undefined || input === '' ? fallback : input;
}

function list<T>(input: T[] | null | undefined, fallback: T[]): T[] {
  return Array.isArray(input) && input.length ? input : fallback;
}

function getReferenceLabel(reference: unknown) {
  if (!reference) return null;
  if (Array.isArray(reference)) {
    const labels = reference.map(getReferenceLabel).filter(Boolean);
    return labels.length ? labels.join(', ') : null;
  }
  if (typeof reference === 'string') {
    return reference.split('/').pop()?.replace(/\.(json|mdx?)$/, '').replace(/-/g, ' ') ?? null;
  }
  if (typeof reference === 'object' && reference) {
    const record = reference as { title?: string | null; name?: string | null };
    return record.title || record.name || null;
  }
  return null;
}

function getPostUrl(post: Post) {
  const url = getBlogPermalink(post);
  return url.endsWith('/') ? url : url + '/';
}

function getPostTitle(post: Post) {
  return post.title || 'Untitled story';
}

function getPostDescription(post: Post) {
  return post.description || 'Read the latest reporting from the newsroom.';
}

function getPostCategories(post: any) {
  const categories = post?.categories;
  if (Array.isArray(categories) && categories.length) return categories;
  return post?.category ? [post.category] : [];
}

function postDate(post: any) {
  const date = post?.pubDate || post?.date || post?.updatedDate;
  if (!date) return 'September 16';
  try {
    return new Intl.DateTimeFormat('en-US', { month: 'long', day: 'numeric' }).format(new Date(date));
  } catch (_error) {
    return 'September 16';
  }
}

function authorName(post: any) {
  return getReferenceLabel(post?.author) || post?.authorAlt || post?.author || 'Staff Reporter';
}

// Public rendering must use Tina Cloud/backend content from `data`.
// `editData` is only for Tina field metadata; do not let local editable payload override public values.
const hero = homepage.hero ?? {};
const why = homepage.why ?? {};
const newsroom = homepage.newsroom ?? {};
const wireFeature = homepage.wireFeature ?? {};
const coverage = homepage.coverage ?? {};
const contact = homepage.contact ?? {};
const editHero = editHomepage.hero ?? hero;
const editWhy = editHomepage.why ?? why;
const editNewsroom = editHomepage.newsroom ?? newsroom;
const editCoverage = editHomepage.coverage ?? coverage;
const editContact = editHomepage.contact ?? contact;

const featuredPosts = posts.slice(0, 4);
const fallbackReportImages = [
  '/brand-assets/83bb832b-c99f-45b5-9bc2-3d615f7d4c6a.jpg',
  '/brand-assets/48aafe34-9438-4012-8c50-c9a8be1499c7.jpg',
  '/brand-assets/5971f731-4646-49ca-998c-9d70b5d14e3d.jpg',
  '/brand-assets/327816c1-cb4e-4c47-8da2-42877a448f1d.jpg',
];

const defaultStandards: any[] = [];
const standards = list(why.standards, defaultStandards);
const coverageTopics = list(coverage.topics, []);
const mockupTeamImages = [
  '/brand-assets/mockup-team/catherine-palmer.png',
  '/brand-assets/mockup-team/nicholas-griffin.png',
  '/brand-assets/mockup-team/denise-chapman.png',
  '/brand-assets/mockup-team/scott-coleman.png',
];
const imagePeople = list(teamBlock?.leadership?.people, []);
const fallbackContactCards = list(contact.cards, []);
const teamCards = imagePeople.map((person: any, index: number) => ({
  title: person.name || fallbackContactCards[index]?.title,
  email: [person.role, person.location].filter(Boolean).join(' · ') || fallbackContactCards[index]?.email,
  text: person.bio || fallbackContactCards[index]?.text,
  image: person.image,
  imageAlt: person.imageAlt || person.name,
  _editImage: editTeamBlock?.leadership?.people?.[index] ?? person,
  _editText: editContact?.cards?.[index] ?? fallbackContactCards[index] ?? person,
}));
function teamImage(person: any, index: number) {
  return person?.image || mockupTeamImages[index] || fallbackReportImages[index % fallbackReportImages.length];
}
const leadTeam = teamCards[0];
const otherTeam = teamCards.slice(1, 4);
---

<main class="ant-home">
  <section class="chero" style={`background-image:url('${value(hero.image, '/brand-assets/c383ae02-84f6-4be0-8a77-47dee93ce41c.jpg')}')`} aria-labelledby="ant-hero-title" data-tina-field={tf(editHero, 'image')}>
    <div class="chero-in"><div class="chero-w">
      <div>
        <div class="ch-kick"><i></i><span data-tina-field={tf(editHero, 'eyebrow')}>{value(hero.eyebrow, '')}</span></div>
        <h1 id="ant-hero-title" class="ch-h" data-tina-field={tf(editHero, 'title')}>{value(hero.title, '')}</h1>
        <p class="ch-d" data-tina-field={tf(editHero, 'description')}>{value(hero.description, '')}</p>
        <div class="ch-by">{standards.slice(0, 4).map((item, index) => <span data-tina-field={tf(editWhy?.standards?.[index] ?? item, 'title')}>{item.title}</span>)}</div>
      </div>
    </div></div>
  </section>

  <section class="dsp" aria-labelledby="filed-this-week-title"><div class="w">
    <div class="dsp-h"><div><div class="dsp-eye"><i></i><span data-tina-field={tf(editNewsroom, 'subheading')}>{value(newsroom.subheading, '')}</span></div><div class="dsp-title" id="filed-this-week-title" data-tina-field={tf(editNewsroom, 'heading')}>{value(newsroom.heading, '')}</div></div></div>
    <div class="dsp-ledger">
      {featuredPosts.map((post, index) => (
        <a href={getPostUrl(post)} class="dr">
          <div class="dr-n">{String(index + 1).padStart(2, '0')}</div>
          <div class="dr-img" style={`background-image:url('${post.heroImage || fallbackReportImages[index % fallbackReportImages.length]}')`}></div>
          <div>
            <div class="dr-cat">{getReferenceLabel(getPostCategories(post)) || 'Featured'}</div>
            <div class="dr-h">{getPostTitle(post)}</div>
            <p class="dr-d">{getPostDescription(post)}</p>
          </div>
          <div class="dr-m"><div class="dr-by">{authorName(post)}</div><div class="dr-dt">{postDate(post)}</div></div>
        </a>
      ))}
    </div>
  </div></section>

  <section class="about"><div class="w"><div class="about-in">
    <div class="about-l">
      <p class="about-l-eye" data-tina-field={tf(editWhy, 'eyebrow')}>{value(why.eyebrow, '')}</p>
      <h2 class="about-l-h" data-tina-field={tf(editWhy, 'title')}>{value(why.title, '')}</h2>
      <p class="about-l-p" data-tina-field={tf(editWhy, 'paragraphOne')}>{value(why.paragraphOne, '')}</p>
      <a href={value(newsroom.submitButtonLink, '/about/')} class="about-cta" data-tina-field={tf(editNewsroom, 'submitButtonText')}>{value(newsroom.submitButtonText, '')}</a>
    </div>
    <div class="about-r">
      <div class="ac-k" data-tina-field={tf(editCoverage, 'title')}>{value(coverage.title, '')}</div>
      {coverageTopics.map((item, index) => {
        const editItem = editCoverage?.topics?.[index] ?? item;
        return <a href="/blog/" class="ac"><span class="ac-n" data-tina-field={tf(editItem, 'number')}>{item.number}</span><span class="ac-t" data-tina-field={tf(editItem, 'title')}>{item.title}</span><span class="ac-x" data-tina-field={tf(editItem, 'text')}>{item.text}</span></a>;
      })}
    </div>
  </div></div></section>

  <section class="stds" aria-labelledby="standards-title"><div class="w">
    <div class="stds-top">
      <div class="stds-eye"><i></i><span data-tina-field={tf(editHomepage.wireFeature ?? wireFeature, 'eyebrow')}>{value(wireFeature.eyebrow, '')}</span></div>
      <h2 id="standards-title" class="stds-h" data-tina-field={tf(editWhy, 'paragraphTwo')}>{value(why.paragraphTwo, '')}</h2>
      <p class="stds-sub" data-tina-field={tf(editCoverage, 'description')}>{value(coverage.description, '')}</p>
    </div>
    <div class="stds-g">
      {standards.slice(0, 5).map((item, index) => {
        const editItem = editWhy?.standards?.[index] ?? item;
        return <div class="sp"><div class="sp-top"><span class="sp-n" data-tina-field={tf(editItem, 'label')}>{item.label}</span><span class="sp-name" data-tina-field={tf(editItem, 'title')}>{item.title}</span></div><p class="sp-def" data-tina-field={tf(editItem, 'text')}>{item.text}</p><div class="sp-prac"><div class="sp-pk" data-tina-field={tf(editNewsroom?.prompts?.[index], 'title')}>{value(newsroom?.prompts?.[index]?.title, '')}</div><p class="sp-px" data-tina-field={tf(editNewsroom?.prompts?.[index], 'text')}>{value(newsroom?.prompts?.[index]?.text, '')}</p></div></div>;
      })}
      <div class="sn"><div class="sn-eye" data-tina-field={tf(editHomepage.wireFeature ?? wireFeature, 'author')}>{value(wireFeature.author, '')}</div><div class="sn-h" data-tina-field={tf(editHomepage.wireFeature ?? wireFeature, 'quote')}>{value(wireFeature.quote, '')}</div><p class="sn-x" data-tina-field={tf(editHomepage.wireFeature ?? wireFeature, 'byline')}>{value(wireFeature.byline, '')}</p><a href={value(hero.buttonLink, '/editorial-guidelines/')} class="sn-cta" data-tina-field={tf(editHero, 'buttonText')}>{value(hero.buttonText, '')}</a></div>
    </div>
  </div></section>

  <section class="tm" aria-labelledby="team-title"><div class="w">
    <div class="tm-top"><div class="tm-eye"><i></i><span data-tina-field={tf(editContact, 'eyebrow')}>{value(contact.eyebrow, '')}</span></div><div class="tm-title" id="team-title" data-tina-field={tf(editContact, 'title')}>{value(contact.title, '')}</div></div>
    {leadTeam && <div class="tml"><img class="tml-img" src={teamImage(leadTeam, 0)} alt={leadTeam.imageAlt || leadTeam.title || ''} data-tina-field={tf(leadTeam?._editImage, 'image')} /><div class="tml-b"><span class="tml-bar" data-tina-field={tf(editContact, 'note')}>{value(contact.note, '')}</span><div class="tml-n" data-tina-field={tf(leadTeam?._editImage, 'name')}>{leadTeam.title}</div><div class="tml-r" data-tina-field={tf(leadTeam?._editText, 'email')}>{leadTeam.email}</div><p class="tml-x" data-tina-field={tf(leadTeam?._editImage, 'bio')}>{leadTeam.text}</p></div></div>}
    <div class="tmr">
      {otherTeam.map((person, index) => {
        const realIndex = index + 1;
        const editPerson = person?._editImage ?? editContact?.cards?.[realIndex] ?? person;
        return <div class="tmi"><div class="tmi-top"><span class="tmi-n">{String(realIndex + 1).padStart(2, '0')}</span><img class="tmi-img" src={teamImage(person, realIndex)} alt={person.imageAlt || person.title || ''} data-tina-field={tf(editPerson, 'image')} /><div><div class="tmi-n2" data-tina-field={tf(editPerson, 'name')}>{person.title}</div><div class="tmi-r" data-tina-field={tf(person?._editText, 'email')}>{person.email}</div></div></div><p class="tmi-x" data-tina-field={tf(editPerson, 'bio')}>{person.text}</p></div>;
      })}
    </div>
  </div></section>
</main>
