---
import { getBlogPermalink } from '../lib/permalinks';
import { labelFromReference, getAuthorName, getPostCategories } from '../components/demo/DemoHelpers';

// Homepage body copied from uploaded home.html demo source. Global Header/Footer remain from Base layout.
// Only the .dsp-ledger rows are dynamic, using the exact demo row classes/structure.
const { posts = [] } = Astro.props;
const reportingPosts = Array.isArray(posts) ? posts.slice(0, 4) : [];
const homeDemoBeforeReporting = `<section class="chero" style="background-image: url(&quot;/brand-assets/home-demo/home-demo-1.jpg&quot;);">
  <div class="chero-in"><div class="chero-w">
    <div>
      <div class="ch-kick"><i></i><span>About the Publication</span></div>
      <h1 class="ch-h">A wider view of today’s America.</h1>
      <p class="ch-d">America’s News Today is a general news platform dedicated to helping readers understand the events, developments, and ideas influencing life across the country. Our purpose is to make important information easier to find and understand — from nationwide developments to the changing trends that affect communities and households.</p>
      <div class="ch-by"><span>Accuracy</span><span>Context</span><span>Clarity</span><span>Accountability</span></div>
    </div>
  </div></div></section><section class="dsp"><div class="w">
  <div class="dsp-h">
    <div>
      <div class="dsp-eye"><i></i><span>Filed this week</span></div>
      <div class="dsp-title">More Reporting</div>
    </div>
  </div>
  <div class="dsp-ledger">`;
const homeDemoAfterReporting = `</div></div></section><section class="about"><div class="w"><div class="about-in">
  <div class="about-l">
    <p class="about-l-eye">About America’s News Today</p>
    <h2 class="about-l-h">Independent thinking starts with better information</h2>
    <p class="about-l-p">America’s News Today does not exist to tell readers what conclusions to reach. Our role is to present information clearly so readers can consider the facts, understand different perspectives, and form their own views. Readers come from different backgrounds and hold different opinions; our goal is coverage that stays useful across those differences.</p>
    <a href="mockup-10-about.dc.html" class="about-cta">About Our Newsroom →</a>
  </div>
  <div class="about-r">
    <div class="ac-k">What we cover</div>
    <a href="#" class="ac"><span class="ac-n">01</span><span class="ac-t">World News</span><span class="ac-x">Global affairs</span></a>
    <a href="#" class="ac"><span class="ac-n">02</span><span class="ac-t">Business</span><span class="ac-x">Markets &amp; the economy</span></a>
    <a href="#" class="ac"><span class="ac-n">03</span><span class="ac-t">Technology</span><span class="ac-x">Innovation &amp; regulation</span></a>
    <a href="#" class="ac"><span class="ac-n">04</span><span class="ac-t">Environment</span><span class="ac-x">Land, energy &amp; climate</span></a>
    <a href="#" class="ac"><span class="ac-n">05</span><span class="ac-t">Education</span><span class="ac-x">Schools &amp; policy</span></a>
    <a href="#" class="ac"><span class="ac-n">06</span><span class="ac-t">Arts &amp; Culture</span><span class="ac-x">Film, music &amp; ideas</span></a>
    <a href="#" class="ac"><span class="ac-n">07</span><span class="ac-t">Lifestyle</span><span class="ac-x">Home, food &amp; everyday life</span></a>
  </div></div></div></section><section class="stds"><div class="w">
  <div class="stds-top">
    <div class="stds-eye"><i></i><span>How we work</span></div>
    <h2 class="stds-h">Editorial Standards</h2>
    <p class="stds-sub">The standards America’s News Today applies to staff reporting, contributed pieces, and any wire or partner material published on the site.</p>
  </div>
  <div class="stds-g">
    <div class="sp">
      <div class="sp-top"><span class="sp-n">01</span><span class="sp-name">Accuracy</span></div>
      <p class="sp-def">Every factual claim should be verifiable. Significant claims are supported by named sources or public records, and anonymous sources only with a senior editor’s judgment.</p>
      <div class="sp-prac">
        <div class="sp-pk">In practice</div>
        <p class="sp-px">Errors discovered after publication are corrected on the record. Accuracy is prioritized over speculation.</p>
      </div>
    </div>
    <div class="sp">
      <div class="sp-top"><span class="sp-n">02</span><span class="sp-name">Sourcing &amp; Attribution</span></div>
      <p class="sp-def">Quoted persons are identified by name and role. Studies, public records, and other reporting are credited and, where possible, linked.</p>
      <div class="sp-prac">
        <div class="sp-pk">In practice</div>
        <p class="sp-px">Where reporting was first developed elsewhere, that publication is credited on first mention.</p>
      </div>
    </div>
    <div class="sp">
      <div class="sp-top"><span class="sp-n">03</span><span class="sp-name">Fairness</span></div>
      <p class="sp-def">People and organizations covered receive a meaningful opportunity to respond to material allegations before publication.</p>
      <div class="sp-prac">
        <div class="sp-pk">In practice</div>
        <p class="sp-px">It does not mean treating contested propositions as equally credible regardless of evidence. When the facts are clear, we report them.</p>
      </div>
    </div>
    <div class="sp">
      <div class="sp-top"><span class="sp-n">04</span><span class="sp-name">Independence</span></div>
      <p class="sp-def">Editorial decisions are made without advertiser, political, or commercial influence of any kind.</p>
      <div class="sp-prac">
        <div class="sp-pk">In practice</div>
        <p class="sp-px">Advertisers and sponsoring parties do not review, approve, or modify editorial reporting before publication.</p>
      </div>
    </div>
    <div class="sp">
      <div class="sp-top"><span class="sp-n">05</span><span class="sp-name">News, Analysis &amp; Opinion</span></div>
      <p class="sp-def">News is presented straight. Analysis interprets the reporting and is labeled. Opinion advances a position and reflects the writer, not the publication.</p>
      <div class="sp-prac">
        <div class="sp-pk">In practice</div>
        <p class="sp-px">The three appear in different sections of the site, are tagged distinctly, and are visibly distinguishable at a glance.</p>
      </div>
    </div>
    <div class="sn">
      <div class="sn-eye">A working note</div>
      <div class="sn-h">Would we stand behind this piece and explain it to a reader?</div>
      <p class="sn-x">Most editorial decisions are matters of judgment. When the rules and the situation do not line up cleanly, the newsroom returns to that question. If the answer is yes, the piece publishes. If not, it holds.</p>
      <a href="#" class="sn-cta">Read the full guidelines →</a>
    </div>
  </div></div></section><section class="tm"><div class="w">
  <div class="tm-top">
    <div class="tm-eye"><i></i><span>The newsroom</span></div>
    <div class="tm-title">Our Team</div>
  </div>
  <div class="tml">
    <img class="tml-img" src="/brand-assets/home-demo/home-demo-7.jpg" alt="Catherine Palmer">
    <div class="tml-b">
      <span class="tml-bar">Leads the newsroom</span>
      <div class="tml-n">Catherine Palmer</div>
      <div class="tml-r">Editor-in-Chief · Indianapolis</div>
      <p class="tml-x">More than fifteen years in editorial leadership at regional and national publications, with a background reporting on politics, state government, and federal courts before she moved into editing. She sets the standards for what runs and is the final authority on what the publication will and will not publish.</p>
    </div>
  </div>
  <div class="tmr">
    <div class="tmi">
      <div class="tmi-top">
        <span class="tmi-n">02</span>
        <img class="tmi-img" src="/brand-assets/home-demo/home-demo-8.jpg" alt="Nicholas Griffin">
        <div>
          <div class="tmi-n2">Nicholas Griffin</div>
          <div class="tmi-r">Managing Editor · Tampa</div>
        </div>
      </div>
      <p class="tmi-x">Twelve years at a Southern regional daily before joining. Runs the editorial calendar, story assignments, and the flow of publication across the desks.</p>
    </div>
    <div class="tmi">
      <div class="tmi-top">
        <span class="tmi-n">03</span>
        <img class="tmi-img" src="/brand-assets/home-demo/home-demo-9.jpg" alt="Denise Chapman">
        <div>
          <div class="tmi-n2">Denise Chapman</div>
          <div class="tmi-r">Business Editor · Grand Rapids</div>
        </div>
      </div>
      <p class="tmi-x">A decade covering business, finance, and labor. Reaches for the underlying numbers and separates what a company announced from what its release implied.</p>
    </div>
    <div class="tmi">
      <div class="tmi-top">
        <span class="tmi-n">04</span>
        <img class="tmi-img" src="/brand-assets/home-demo/home-demo-10.jpg" alt="Scott Coleman">
        <div>
          <div class="tmi-n2">Scott Coleman</div>
          <div class="tmi-r">Publisher · Dallas</div>
        </div>
      </div>
      <p class="tmi-x">Background in media and business operations. Holds responsibility for the site’s direction and for keeping the editorial operation independent of the commercial side.</p>
    </div>
  </div></div></section>`;

function postUrl(post: any) {
  const url = getBlogPermalink(post);
  return url.endsWith('/') ? url : url + '/';
}
function postDate(post: any) {
  const raw = post?.pubDate || post?.date || post?.updatedDate;
  if (!raw) return '';
  try {
    return new Intl.DateTimeFormat('en-US', { month: 'long', day: 'numeric' }).format(new Date(raw));
  } catch (_error) {
    return '';
  }
}
function postImageStyle(post: any) {
  return post?.heroImage ? `background-image: url("${post.heroImage}");` : undefined;
}
---
<main class="home-source-body">
  <Fragment set:html={homeDemoBeforeReporting} />
  {reportingPosts.map((post: any, index: number) => (
    <a href={postUrl(post)} class="dr">
      <div class="dr-n">{String(index + 1).padStart(2, '0')}</div>
      <div class="dr-img" style={postImageStyle(post)}></div>
      <div>
        <div class="dr-cat">{labelFromReference(getPostCategories(post), 'News')}</div>
        <div class="dr-h">{post.title || 'Untitled story'}</div>
        {post.description && <p class="dr-d">{post.description}</p>}
      </div>
      <div class="dr-m"><div class="dr-by">{getAuthorName(post.author, 'Americas News Today Staff')}</div><div class="dr-dt">{postDate(post)}</div></div>
    </a>
  ))}
  <Fragment set:html={homeDemoAfterReporting} />
</main>
