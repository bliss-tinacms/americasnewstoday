---
import { tinaField } from '@tinacms/astro/tina-field';
const { data = null } = Astro.props;
const block = Array.isArray(data?.blocks) ? data.blocks[0] : data;
const hero = block?.hero || {};
const purpose = block?.purpose || {};
const coverage = block?.coverage || {};
const standards = block?.standardsSection || {};
const independence = block?.independence || {};
const newsroom = block?.newsroom || {};
const coverageItems = Array.isArray(coverage?.items) ? coverage.items : [];
const standardItems = Array.isArray(standards?.items) ? standards.items : [];
const contacts = Array.isArray(newsroom?.contacts) ? newsroom.contacts : [];
const t = (v:any, f='') => v ?? f;
---
<main class="ffn-demo ffn-demo-about">
<header class="ph"><div class="w"><div class="ph-in">
  <div class="ph-kick"><i></i><span data-tina-field={hero ? tinaField(hero,'eyebrow') : undefined}>{t(hero.eyebrow,'About America’s News Today')}</span></div>
  <h1 data-tina-field={hero ? tinaField(hero,'headline') : undefined}>{t(hero.headline,'A wider view of the country, in one place.')}</h1>
  <p data-tina-field={hero ? tinaField(hero,'lede') : undefined}>{t(hero.lede,'America’s News Today is a general news platform dedicated to helping readers understand the events, developments, and ideas influencing life across the country. We bring together timely reporting, useful context, and diverse subject coverage in one accessible destination.')}</p></div></div></header>
<section id="purpose" class="sec"><div class="w"><div class="pp">
  <div class="pp-h"><h2 class="h2" data-tina-field={purpose ? tinaField(purpose,'title') : undefined}>{t(purpose.title,'Our Purpose')}</h2><div class="pp-tag" data-tina-field={purpose ? tinaField(purpose,'eyebrow') : undefined}>{t(purpose.eyebrow,'Why we publish')}</div></div>
  <p class="pp-lead" data-tina-field={purpose ? tinaField(purpose,'paragraphOne') : undefined}>{t(purpose.paragraphOne,'Our purpose is to make important information easier to find and understand — from nationwide developments to the changing trends that reach communities and households.')}</p>
  <div class="pp-cols"><div class="pp-c"><div class="pp-ck">The scale of it</div><p data-tina-field={purpose ? tinaField(purpose,'paragraphTwo') : undefined}>{t(purpose.paragraphTwo,'America is shaped by millions of people, communities, industries, and experiences. No single subject can fully capture what is happening across the country, which is why we report across all of them.')}</p></div><div class="pp-c"><div class="pp-ck">National to local</div><p data-tina-field={purpose ? tinaField(purpose,'pullquote') : undefined}>{t(purpose.pullquote,'We examine how national conversations connect with local realities. A policy decision, technological advancement, business trend, or cultural shift lands differently from one community to another. Our coverage aims to make those connections clearer.')}</p></div></div>
</div></div></section>
<section id="coverage" class="sec alt"><div class="w"><div class="sec-eye"><i></i><span data-tina-field={coverage ? tinaField(coverage,'eyebrow') : undefined}>{t(coverage.eyebrow,'Editorial scope')}</span></div><h2 class="h2" data-tina-field={coverage ? tinaField(coverage,'title') : undefined}>{t(coverage.title,'A Wider View of Today’s America')}</h2><div class="cg">
{coverageItems.map((item:any, index:number) => <a href={item.link || '#'} class="cg-r"><div class="cg-n" data-tina-field={tinaField(item,'number')}>{item.number || String(index+1).padStart(2,'0')}</div><div class="cg-t" data-tina-field={tinaField(item,'title')}>{item.title}</div><p class="cg-x" data-tina-field={tinaField(item,'text')}>{item.text}</p></a>)}
</div></div></section>
<section id="headline" class="sec"><div class="w"><div class="sec-eye"><i></i><span data-tina-field={standards ? tinaField(standards,'eyebrow') : undefined}>{t(standards.eyebrow,'How we write')}</span></div><div class="bh"><div class="bh-l"><h2 class="h2" data-tina-field={standards ? tinaField(standards,'title') : undefined}>{t(standards.title,'Going Beyond the Headline')}</h2><div class="bh-q"><p data-tina-field={standards ? tinaField(standards,'intro') : undefined}>{t(standards.intro,'Whether someone is following a developing story or exploring a subject for the first time, we strive to provide a helpful and understandable starting point.')}</p><span>Our standard for every piece</span></div></div><div class="bh-r">{standardItems.slice(0,2).map((item:any,index:number)=><div class="bh-row"><div class="bh-n">{item.number || String(index+1).padStart(2,'0')}</div><p data-tina-field={tinaField(item,'text')}>{item.text}</p></div>)}</div></div></div></section>
<section id="values" class="sec alt"><div class="w"><div class="sec-eye"><i></i><span>How we work</span></div><h2 class="h2">Our Editorial Values</h2><table class="st"><thead><tr><th style="width: 190px;">Value</th><th>What It Means in Practice</th></tr></thead><tbody>{standardItems.map((item:any)=><tr><td class="st-n" data-tina-field={tinaField(item,'title')}>{item.title}</td><td class="st-d" data-tina-field={tinaField(item,'text')}>{item.text}</td></tr>)}</tbody></table></div></section>
<section id="independence" class="ind"><div class="w"><div class="ind-in"><div><div class="sec-eye"><i></i><span data-tina-field={independence ? tinaField(independence,'eyebrow') : undefined}>{t(independence.eyebrow,'Our role')}</span></div><h2 data-tina-field={independence ? tinaField(independence,'title') : undefined}>{t(independence.title,'Independent thinking starts with better information.')}</h2><p data-tina-field={independence ? tinaField(independence,'paragraphOne') : undefined}>{t(independence.paragraphOne,'America’s News Today does not exist to tell readers what conclusions to reach.')}</p><p data-tina-field={independence ? tinaField(independence,'paragraphTwo') : undefined}>{t(independence.paragraphTwo,'We recognize that readers come from different backgrounds and hold different opinions.')}</p><a href={independence.buttonLink || '#'} class="ind-cta" data-tina-field={independence ? tinaField(independence,'buttonText') : undefined}>{t(independence.buttonText,'Read our editorial guidelines →')}</a></div><div class="ind-stats"><div class="ist"><span class="ist-n">10</span><span class="ist-l">Subject areas</span></div><div class="ist"><span class="ist-n">8</span><span class="ist-l">Published values</span></div><div class="ist"><span class="ist-n">0</span><span class="ist-l">Sponsor review</span></div><div class="ist"><span class="ist-n">50</span><span class="ist-l">States covered</span></div></div></div></div></section>
<section id="accountability" class="sec alt"><div class="w"><div class="sec-eye"><i></i><span data-tina-field={newsroom ? tinaField(newsroom,'eyebrow') : undefined}>{t(newsroom.eyebrow,'Accountability to our readers')}</span></div><h2 class="h2" data-tina-field={newsroom ? tinaField(newsroom,'title') : undefined}>{t(newsroom.title,'Tell Us When We Get It Wrong')}</h2><p class="acc-p" data-tina-field={newsroom ? tinaField(newsroom,'intro') : undefined}>{t(newsroom.intro,'Reader trust is central to our work.')}</p><div class="cr">{contacts.map((c:any)=><a href={`mailto:${c.email}`} class="crc"><div class="crc-t" data-tina-field={tinaField(c,'title')}>{c.title}</div><div class="crc-a" data-tina-field={tinaField(c,'email')}>{c.email}</div><p class="crc-x" data-tina-field={tinaField(c,'text')}>{c.text}</p></a>)}</div></div></section>
<section class="cl"><div class="w"><h2>Stay current with America’s News Today</h2><p data-tina-field={newsroom ? tinaField(newsroom,'intro') : undefined}>{t(newsroom.intro,'The country never stops changing, and the stories shaping its future continue to unfold every day.')}</p><a href="/" class="cl-cta">Read today’s stories</a></div></section>
</main>
