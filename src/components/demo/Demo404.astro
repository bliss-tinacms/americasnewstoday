---
import { getBlogPermalink } from '../../lib/permalinks';
import { labelFromReference, getAuthorName, getPostCategories } from './DemoHelpers';
const { posts=[] }=Astro.props; const latest=posts.slice(0,3); function postUrl(post:any){const url=getBlogPermalink(post);return url.endsWith('/')?url:url+'/'}
---
<main class="ffn-demo ffn-demo-404"><header class="er"><div class="w"><div class="er-in"><div class="er-n">404</div><div class="er-b"><div class="er-kick"><i></i><span>Page not found</span></div><h1>This page is not where it used to be.</h1><p>The link may be broken, the story may have moved, or the address may contain a typo. Everything else on the site is still here.</p><div class="er-a"><a href="/" class="btn btn-p">Back to the homepage →</a><a href="/blog/" class="btn btn-s">Browse latest reporting</a></div></div></div></div></header><section class="sec"><div class="w"><div class="eye"><i></i><span>Published this week</span></div><h2 class="h2">Latest Reporting</h2><div>{latest.map((post:any)=><a href={postUrl(post)} class="pr"><div class="pr-img" style={post.heroImage?`background-image:url(${post.heroImage})`:undefined}></div><div><div class="pr-cat">{labelFromReference(getPostCategories(post),'News')}</div><div class="pr-t">{post.title}</div>{post.description&&<p class="pr-x">{post.description}</p>}</div><div class="pr-m"><div class="pr-by">{getAuthorName(post.author,'Americas News Today Staff')}</div><div class="pr-dt">{post.pubDate ? new Date(post.pubDate).toLocaleDateString('en-US',{month:'short',day:'numeric'}) : ''}</div></div></a>)}</div></div></section></main>
