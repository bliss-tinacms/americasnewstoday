---
import { tinaField } from "@tinacms/astro/tina-field";
import type { CmsConfig } from '../lib/data';

type NavItem = {
  label?: string | null;
  href?: string | null;
};

type NavigationDocument = {
  title?: string | null;
  items?: (NavItem | null)[] | null;
};

interface Props {
  config?: CmsConfig | null;
  navigation?: NavigationDocument | null;
  coverageNavigation?: NavigationDocument | null;
}

const { config, navigation, coverageNavigation } = Astro.props;
const currentYear = new Date().getFullYear();
const seo = config?.seo ?? null;
const siteTitle = seo?.title || 'Americas News Today';
const footerDescription = seo?.description || 'A general news platform covering the events, developments, and ideas influencing life across the country — business, technology, health, politics, world affairs, and lifestyle.';
// Footer Logo must drive the footer when set; fall back to the main Logo only when Footer Logo is empty.
const footerLogo = seo?.footerLogo || seo?.logo || '/brand-assets/a80bca69-bdf7-4a94-80eb-063779debed2.png';
const newsroomItems = ((navigation?.items ?? []) as NavItem[]).filter((item) => item && item.label && item.href);
const coverageItems = ((coverageNavigation?.items ?? []) as NavItem[]).filter((item) => item && item.label && item.href);
const infoLinks = [
  { label: 'Privacy', href: '/privacy-policy/' },
  { label: 'Terms', href: '/terms-of-use/' },
  { label: 'Cookie', href: '/cookie-policy/' },
  { label: 'AI', href: '/ai-policy/' },
  { label: 'DMCA', href: '/dmca-policy/' },
  { label: 'Sponsored', href: '/sponsored-content-policy/' },
];
---

<footer class="foot" data-brand-footer><div class="w">
  <div class="fg-grid">
    <div class="fb"><a href="/" class="fn"><img src={footerLogo} alt={siteTitle} data-tina-field={seo ? tinaField(seo, 'footerLogo') : undefined} loading="lazy" decoding="async" /></a><p data-tina-field={seo ? tinaField(seo, 'description') : undefined}>{footerDescription}</p></div>
    <div class="fc"><h4>Coverage</h4><ul>{coverageItems.map((item) => <li><a href={item.href || '#'} data-tina-field={tinaField(item, 'label')}>{item.label}</a></li>)}</ul></div>
    <div class="fc"><h4>{navigation?.title || 'Newsroom'}</h4><ul>{newsroomItems.map((item) => <li><a href={item.href || '#'} data-tina-field={tinaField(item, 'label')}>{item.label}</a></li>)}</ul></div>
    <div class="fc"><h4>Information</h4><ul>{infoLinks.map((item) => <li><a href={item.href}>{item.label}</a></li>)}</ul></div>
  </div>
  <div class="foot-btm"><p>&copy; {currentYear} {siteTitle}. All rights reserved. americasnewstoday.org</p></div>
</div></footer>
