---
// 404 body copied from uploaded 404.html demo source. Global Header/Footer remain from Base layout.
// Latest Reporting rows are dynamic from backend posts passed by the route, preserving demo classes/CSS.
import { getBlogPermalink } from '../../lib/permalinks';
import { firstImage, getAuthorName, getPostCategories, labelFromReference, normalizeText } from './DemoHelpers';

const { posts = [] } = Astro.props;
const latestPosts = Array.isArray(posts) ? posts.slice(0, 3) : [];
const fallbackImages = [
  '/brand-assets/404-demo/404-demo-3.jpg',
  '/brand-assets/404-demo/404-demo-4.jpg',
  '/brand-assets/404-demo/404-demo-5.jpg',
];
function postImage(post: any, index: number) {
  return firstImage(post) || fallbackImages[index % fallbackImages.length];
}
function postCategoryLabel(post: any) {
  const categories = getPostCategories(post);
  return labelFromReference(Array.isArray(categories) ? categories[0] : categories, 'News');
}
function postTitle(post: any) {
  return normalizeText(post?.title || post?.seo?.metaTitle || post?._sys?.filename, 'Untitled story');
}
function postExcerpt(post: any) {
  return normalizeText(post?.description || post?.excerpt || post?.seo?.metaDescription, 'Read the latest reporting from Americas News Today.');
}
function postAuthor(post: any) {
  return getAuthorName(post?.author || post?.authorAlt, 'Americas News Today Staff');
}
function postDate(post: any) {
  const value = post?.pubDate || post?.date;
  if (!value) return '';
  const date = new Date(value);
  if (Number.isNaN(date.getTime())) return '';
  return new Intl.DateTimeFormat('en-US', { month: 'short', day: 'numeric' }).format(date);
}
---
<main class="error-source-body">
<header class="er"><div class="w"><div class="er-in">
  <div class="er-n">404</div>
  <div class="er-b">
    <div class="er-kick"><i></i><span>Page not found</span></div>
    <h1>This page is not where it used to be.</h1>
    <p>The link may be broken, the story may have moved, or the address may contain a typo. Everything else on the site is still here.</p>
    <div class="er-a">
      <a href="/" class="btn btn-p">Back to the homepage →</a>
      <a href="/business/" class="btn btn-s">Browse latest reporting</a>
    </div>
  </div></div></div></header><section class="sec"><div class="w">
  <div class="eye"><i></i><span>Published this week</span></div>
  <h2 class="h2">Latest Reporting</h2>
  <div>
    {latestPosts.map((post: any, index: number) => (
      <a href={`${getBlogPermalink(post)}/`} class="pr">
        <div class="pr-img" style={`background-image: url("${postImage(post, index)}");`}></div>
        <div>
          <div class="pr-cat">{postCategoryLabel(post)}</div>
          <div class="pr-t">{postTitle(post)}</div>
          <p class="pr-x">{postExcerpt(post)}</p>
        </div>
        <div class="pr-m"><div class="pr-by">{postAuthor(post)}</div>{postDate(post) && <div class="pr-dt">{postDate(post)}</div>}</div>
      </a>
    ))}
  </div></div></section>
</main>
