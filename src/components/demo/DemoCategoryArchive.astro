---
import { tinaField } from '@tinacms/astro/tina-field';
import { getBlogPermalink } from '../../lib/permalinks';
import { labelFromReference, getAuthorName, getPostCategories } from './DemoHelpers';
const { archiveTitle='Business', posts=[], currentPage=1, totalPages=1, basePath='/business', category=null, showCategoryBadge=true }=Astro.props;
function postUrl(post:any){const url=getBlogPermalink(post);return url.endsWith('/')?url:url+'/'} function pagePath(page:number){return page<=1?basePath+'/':basePath+'/page/'+page+'/'}
---
<main class="ffn-demo ffn-demo-category"><header class="ah"><div class="w"><div class="ah-b"><div><div class="ah-kick"><i></i><span>{showCategoryBadge?'Category Archive':'Archive'}</span></div><h1 data-tina-field={category ? tinaField(category,'title') : undefined}>{archiveTitle}</h1></div></div></div></header><section class="pl"><div class="w"><div class="pl-h"><div><div class="pl-eye"><i></i><span>Most recent first</span></div><div class="pl-t">Latest Reporting</div></div><div class="pl-c">Page {currentPage} of {totalPages}</div></div><div class="pl-l">{posts.length?posts.map((post:any)=><a href={postUrl(post)} class="pr"><div class="pr-img" style={post.heroImage?`background-image:url(${post.heroImage})`:undefined}></div><div><div class="pr-cat">{labelFromReference(getPostCategories(post), archiveTitle)}</div><div class="pr-t">{post.title}</div>{post.description&&<p class="pr-x">{post.description}</p>}</div><div class="pr-m"><div class="pr-by">{getAuthorName(post.author,'Americas News Today Staff')}</div><div class="pr-dt">{post.pubDate ? new Date(post.pubDate).toLocaleDateString('en-US',{month:'short',day:'numeric'}) : ''}</div></div></a>):<div class="empty-archive"><p>There are no articles published yet under {archiveTitle}. Please check back soon for new coverage.</p><a href="/" class="empty-archive__link">Back to the homepage</a></div>}</div></div></section>{totalPages>1&&<section class="pg"><div class="w"><div class="pg-in"><a class="nx" href={pagePath(Math.max(1,currentPage-1))}>Prev</a>{Array.from({length:Math.min(totalPages,3)}).map((_,i)=>{const p=i+1;return <a class={p===currentPage?'on':''} href={pagePath(p)}>{p}</a>})}<span class="gap">…</span><a href={pagePath(totalPages)}>{totalPages}</a><a class="nx" href={pagePath(Math.min(totalPages,currentPage+1))}>Next →</a></div></div></section>}</main>
