---
import { getBlogPermalink } from '../lib/permalinks';
import { labelFromReference, getAuthorName, getPostCategories } from '../components/demo/DemoHelpers';
import { tinaField } from '@tinacms/astro/tina-field';

// Homepage body copied from uploaded home.html demo source. Global Header/Footer remain from Base layout.
// Visible homepage values are Tina Cloud/backend page data first; local files are fallback only.
const { posts = [], data = {}, editData = data } = Astro.props;
const reportingPosts = Array.isArray(posts) ? posts.slice(0, 4) : [];
const blocks = Array.isArray(data?.blocks) ? data.blocks : [];
const editBlocks = Array.isArray(editData?.blocks) ? editData.blocks : blocks;
const homeBlock = blocks.find((block: any) => block?._template === 'homepageTemplate' || block?.__typename === 'PageBlocksHomepageTemplate') || blocks[0] || {};
const editHomeBlock = editBlocks.find((block: any) => block?._template === 'homepageTemplate' || block?.__typename === 'PageBlocksHomepageTemplate') || editBlocks[0] || homeBlock;
const hero = homeBlock.hero || {};
const editHero = editHomeBlock.hero || hero;
const why = homeBlock.why || {};
const editWhy = editHomeBlock.why || why;
const newsroom = homeBlock.newsroom || {};
const editNewsroom = editHomeBlock.newsroom || newsroom;
const wireFeature = homeBlock.wireFeature || {};
const editWireFeature = editHomeBlock.wireFeature || wireFeature;
const coverage = homeBlock.coverage || {};
const editCoverage = editHomeBlock.coverage || coverage;
const contact = homeBlock.contact || {};
const editContact = editHomeBlock.contact || contact;

const heroImage = hero.image || '/brand-assets/home-demo/home-demo-1.jpg';
const heroEyebrow = hero.eyebrow || 'About the Publication';
const heroTitle = hero.title || 'A wider view of today’s America.';
const heroDescription = hero.description || 'America’s News Today is a general news platform dedicated to helping readers understand the events, developments, and ideas influencing life across the country. Our purpose is to make important information easier to find and understand — from nationwide developments to the changing trends that affect communities and households.';
const whyEyebrow = why.eyebrow || 'About America’s News Today';
const whyTitle = why.title || 'Independent thinking starts with better information';
const whyParagraph = why.paragraphOne || '';
const standards = Array.isArray(why.standards) ? why.standards : [];
const prompts = Array.isArray(newsroom.prompts) ? newsroom.prompts : [];
const topics = Array.isArray(coverage.topics) ? coverage.topics : [];
const teamCards = Array.isArray(contact.cards) ? contact.cards : [];
const leadTeam = teamCards.find((card: any) => card?.accent) || teamCards[0] || {};
const otherTeam = teamCards.filter((card: any) => card !== leadTeam).slice(0, 3);
const leadImage = contact.leadImage || '/brand-assets/home-demo/home-demo-7.jpg';
const teamImages = ['/brand-assets/home-demo/home-demo-8.jpg', '/brand-assets/home-demo/home-demo-9.jpg', '/brand-assets/home-demo/home-demo-10.jpg'];

function postUrl(post: any) {
  const url = getBlogPermalink(post);
  return url.endsWith('/') ? url : url + '/';
}
function postDate(post: any) {
  const raw = post?.pubDate || post?.date || post?.updatedDate;
  if (!raw) return '';
  try { return new Intl.DateTimeFormat('en-US', { month: 'long', day: 'numeric' }).format(new Date(raw)); } catch (_error) { return ''; }
}
function postImageStyle(post: any) {
  return post?.heroImage ? `background-image: url("${post.heroImage}");` : undefined;
}
function field(target: any, name: string) {
  try { return tinaField(target, name); } catch (_error) { return undefined; }
}
---
<main class="home-source-body">
  <section class="chero" style={`background-image: url("${heroImage}");`} data-tina-field={field(editHero, 'image')}>
    <div class="chero-in"><div class="chero-w">
      <div>
        <div class="ch-kick" data-tina-field={field(editHero, 'eyebrow')}><i></i><span>{heroEyebrow}</span></div>
        <h1 class="ch-h" data-tina-field={field(editHero, 'title')}>{heroTitle}</h1>
        <p class="ch-d" data-tina-field={field(editHero, 'description')}>{heroDescription}</p>
        <div class="ch-by"><span>Accuracy</span><span>Context</span><span>Clarity</span><span>Accountability</span></div>
      </div>
    </div></div>
  </section>
  <section class="dsp"><div class="w">
    <div class="dsp-h">
      <div>
        <div class="dsp-eye" data-tina-field={field(editNewsroom, 'subheading')}><i></i><span>{newsroom.subheading || 'Filed this week'}</span></div>
        <div class="dsp-title" data-tina-field={field(editNewsroom, 'heading')}>{newsroom.heading || 'More Reporting'}</div>
      </div>
    </div>
    <div class="dsp-ledger">
      {reportingPosts.map((post: any, index: number) => (
        <a href={postUrl(post)} class="dr">
          <div class="dr-n">{String(index + 1).padStart(2, '0')}</div>
          <div class="dr-img" style={postImageStyle(post)}></div>
          <div>
            <div class="dr-cat">{labelFromReference(getPostCategories(post), 'News')}</div>
            <div class="dr-h">{post.title || 'Untitled story'}</div>
            {post.description && <p class="dr-d">{post.description}</p>}
          </div>
          <div class="dr-m"><div class="dr-by">{getAuthorName(post.author, 'Americas News Today Staff')}</div><div class="dr-dt">{postDate(post)}</div></div>
        </a>
      ))}
    </div>
  </div></section>
  <section class="about"><div class="w"><div class="about-in">
    <div class="about-l">
      <p class="about-l-eye" data-tina-field={field(editWhy, 'eyebrow')}>{whyEyebrow}</p>
      <h2 class="about-l-h" data-tina-field={field(editWhy, 'title')}>{whyTitle}</h2>
      <p class="about-l-p" data-tina-field={field(editWhy, 'paragraphOne')}>{whyParagraph}</p>
      <a href="/about/" class="about-cta">About Our Newsroom →</a>
    </div>
    <div class="about-r">
      <div class="ac-k" data-tina-field={field(editCoverage, 'title')}>{coverage.title || 'What we cover'}</div>
      {(topics.length ? topics : [
        {number:'01',title:'World News',text:'Global affairs'}, {number:'02',title:'Business',text:'Markets & the economy'}, {number:'03',title:'Technology',text:'Innovation & regulation'}, {number:'04',title:'Environment',text:'Land, energy & climate'}, {number:'05',title:'Education',text:'Schools & policy'}, {number:'06',title:'Arts & Culture',text:'Film, music & ideas'}, {number:'07',title:'Lifestyle',text:'Home, food & everyday life'}
      ]).map((topic: any, index: number) => (
        <a href="#" class="ac" data-tina-field={field((editCoverage.topics || [])[index] || topic, 'title')}><span class="ac-n">{topic.number || String(index + 1).padStart(2, '0')}</span><span class="ac-t">{topic.title}</span><span class="ac-x">{topic.text}</span></a>
      ))}
    </div>
  </div></div></section>
  <section class="stds"><div class="w">
    <div class="stds-top">
      <div class="stds-eye" data-tina-field={field(editWireFeature, 'eyebrow')}><i></i><span>{wireFeature.eyebrow || 'How we work'}</span></div>
      <h2 class="stds-h" data-tina-field={field(editWhy, 'paragraphTwo')}>{why.paragraphTwo || 'Editorial Standards'}</h2>
      <p class="stds-sub" data-tina-field={field(editCoverage, 'description')}>{coverage.description || 'The standards America’s News Today applies to staff reporting, contributed pieces, and any wire or partner material published on the site.'}</p>
    </div>
    <div class="stds-g">
      {standards.slice(0,5).map((item: any, index: number) => (
        <div class="sp" data-tina-field={field((editWhy.standards || [])[index] || item, 'title')}>
          <div class="sp-top"><span class="sp-n">{item.label || String(index + 1).padStart(2, '0')}</span><span class="sp-name">{item.title}</span></div>
          <p class="sp-def">{item.text}</p>
          <div class="sp-prac">
            <div class="sp-pk">{prompts[index]?.title || 'In practice'}</div>
            <p class="sp-px" data-tina-field={field((editNewsroom.prompts || [])[index] || prompts[index] || {}, 'text')}>{prompts[index]?.text || ''}</p>
          </div>
        </div>
      ))}
      <div class="sn">
        <div class="sn-eye" data-tina-field={field(editWireFeature, 'author')}>{wireFeature.author || 'A working note'}</div>
        <div class="sn-h" data-tina-field={field(editWireFeature, 'quote')}>{wireFeature.quote || 'Would we stand behind this piece and explain it to a reader?'}</div>
        <p class="sn-x" data-tina-field={field(editWireFeature, 'byline')}>{wireFeature.byline || ''}</p>
        <a href="/about/" class="sn-cta">{newsroom.submitHeading || 'Read the full guidelines →'}</a>
      </div>
    </div>
  </div></section>
  <section class="tm"><div class="w">
    <div class="tm-top">
      <div class="tm-eye" data-tina-field={field(editContact, 'eyebrow')}><i></i><span>{contact.eyebrow || 'The newsroom'}</span></div>
      <div class="tm-title" data-tina-field={field(editContact, 'title')}>{contact.title || 'Our Team'}</div>
    </div>
    <div class="tml">
      <img class="tml-img" src={leadImage} alt={leadTeam.title || 'Lead team member'} data-tina-field={field(editContact, 'leadImage')}>
      <div class="tml-b">
        <span class="tml-bar" data-tina-field={field(editContact, 'note')}>{contact.note || 'Leads the newsroom'}</span>
        <div class="tml-n" data-tina-field={field(leadTeam, 'title')}>{leadTeam.title || 'Catherine Palmer'}</div>
        <div class="tml-r" data-tina-field={field(leadTeam, 'email')}>{leadTeam.email || 'Editor-in-Chief · Indianapolis'}</div>
        <p class="tml-x" data-tina-field={field(leadTeam, 'text')}>{leadTeam.text || ''}</p>
      </div>
    </div>
    <div class="tmr">
      {otherTeam.map((member: any, index: number) => (
        <div class="tmi">
          <div class="tmi-top">
            <span class="tmi-n">{String(index + 2).padStart(2, '0')}</span>
            <img class="tmi-img" src={teamImages[index] || teamImages[0]} alt={member.title || ''}>
            <div>
              <div class="tmi-n2" data-tina-field={field(member, 'title')}>{member.title}</div>
              <div class="tmi-r" data-tina-field={field(member, 'email')}>{member.email}</div>
            </div>
          </div>
          <p class="tmi-x" data-tina-field={field(member, 'text')}>{member.text}</p>
        </div>
      ))}
    </div>
  </div></section>
</main>
