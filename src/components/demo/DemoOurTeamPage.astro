---
import { tinaField } from '@tinacms/astro/tina-field';
const { data = null } = Astro.props;
const block = Array.isArray(data?.blocks) ? data.blocks[0] : data;
const hero = block?.hero || {};
const leadership = block?.leadership || {};
const seniorStaff = block?.seniorStaff || {};
const people = Array.isArray(leadership?.people) && leadership.people.length ? leadership.people : [];
const t=(v:unknown,f='')=>String(v||f);
---
<main class="ffn-demo ffn-demo-team">
  <header class="ph"><div class="w"><div class="ph-in"><div class="ph-kick"><i></i><span data-tina-field={hero ? tinaField(hero,'eyebrow') : undefined}>{t(hero.eyebrow,'The Masthead')}</span></div><h1 data-tina-field={hero ? tinaField(hero,'headline') : undefined}>{t(hero.headline,'The journalists behind the reporting.')}</h1><p data-tina-field={hero ? tinaField(hero,'lede') : undefined}>{t(hero.lede,'America’s News Today is published by editors and reporters responsible for accuracy, context, and coverage decisions.')}</p></div></div></header>
  <section class="ros"><div class="w"><div class="ros-l"><div class="ros-eye"><i></i><span data-tina-field={leadership ? tinaField(leadership,'eyebrow') : undefined}>{t(leadership.eyebrow,'Editorial leadership')}</span></div><h2 class="ros-h" data-tina-field={leadership ? tinaField(leadership,'title') : undefined}>{t(leadership.title,'Leads the newsroom')}</h2></div><div class="ros-c">{people.map((p:any,index:number)=><a class="rr" href={`/blog/author/${String(p.name||'').toLowerCase().replace(/[^a-z0-9]+/g,'-').replace(/^-+|-+$/g,'')}/`}><div class="rr-n">{String(index+1).padStart(2,'0')}</div><div><div class="rr-nm" data-tina-field={tinaField(p,'name')}>{p.name}</div><div class="rr-rl" data-tina-field={tinaField(p,'role')}>{p.role}</div></div><div class="rr-lc" data-tina-field={tinaField(p,'location')}>{p.location}</div></a>)}</div></div></section>
  <section>{people.map((p:any,index:number)=><article class={`pf ${index%2?'alt':''}`}><div class="w"><div class="pf-in"><div class="pf-img" style={p.image?`background-image:url(${p.image})`:undefined} data-tina-field={tinaField(p,'image')}></div><div class="pf-r"><div class="pf-idx">{String(index+1).padStart(2,'0')}</div><h2 class="pf-n" data-tina-field={tinaField(p,'name')}>{p.name}</h2><div class="pf-meta"><span data-tina-field={tinaField(p,'role')}>{p.role}</span><span data-tina-field={tinaField(p,'location')}>{p.location}</span></div><p class="pf-q" data-tina-field={tinaField(p,'bio')}>{p.bio}</p></div></div></div></article>)}</section>
  <section class="jn"><div class="w"><div class="jn-in"><div><div class="jn-eye"><i></i><span data-tina-field={seniorStaff ? tinaField(seniorStaff,'eyebrow') : undefined}>{t(seniorStaff.eyebrow,'Contact the newsroom')}</span></div><h2 data-tina-field={seniorStaff ? tinaField(seniorStaff,'title') : undefined}>{t(seniorStaff.title,'Work with the editors')}</h2></div><div class="jn-r"><p>Corrections and reader concerns are handled by the editorial team responsible for the published coverage.</p><a class="jn-cta" href="/contact/">Contact the newsroom →</a></div></div></div></section>
</main>
