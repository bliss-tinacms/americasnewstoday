---
import { tinaField } from '@tinacms/astro/tina-field';
const { data = null } = Astro.props;
const block = Array.isArray(data?.blocks) ? data.blocks[0] : data;
const hero = block?.hero || {};
const purpose = block?.purpose || {};
const coverage = block?.coverage || {};
const standards = block?.standardsSection || {};
const independence = block?.independence || {};
const newsroom = block?.newsroom || {};
const coverageItems = Array.isArray(coverage?.items) && coverage.items.length ? coverage.items : [];
const standardItems = Array.isArray(standards?.items) && standards.items.length ? standards.items : [];
const contacts = Array.isArray(newsroom?.contacts) && newsroom.contacts.length ? newsroom.contacts : [];
const t = (value: unknown, fallback = '') => String(value || fallback);
---
<main class="ffn-demo ffn-demo-about">
  <header class="ph"><div class="w"><div class="ph-in">
    <div class="ph-kick"><i></i><span data-tina-field={hero ? tinaField(hero, 'eyebrow') : undefined}>{t(hero.eyebrow, 'About America’s News Today')}</span></div>
    <h1 data-tina-field={hero ? tinaField(hero, 'headline') : undefined}>{t(hero.headline, 'A wider view of the country, in one place.')}</h1>
    <p data-tina-field={hero ? tinaField(hero, 'lede') : undefined}>{t(hero.lede, 'America’s News Today is a general news platform dedicated to helping readers understand the events, developments, and ideas influencing life across the country.')}</p>
  </div></div></header>
  <section id="purpose" class="sec"><div class="w"><div class="pp">
    <div class="pp-h"><h2 class="h2" data-tina-field={purpose ? tinaField(purpose, 'title') : undefined}>{t(purpose.title, 'Our Purpose')}</h2><div class="pp-tag" data-tina-field={purpose ? tinaField(purpose, 'eyebrow') : undefined}>{t(purpose.eyebrow, 'Why we publish')}</div></div>
    <p class="pp-lead" data-tina-field={purpose ? tinaField(purpose, 'paragraphOne') : undefined}>{t(purpose.paragraphOne, 'Our purpose is to make important information easier to find and understand — from nationwide developments to the changing trends that reach communities and households.')}</p>
    <div class="pp-cols">
      <div class="pp-c"><div class="pp-ck">The scale of it</div><p data-tina-field={purpose ? tinaField(purpose, 'paragraphTwo') : undefined}>{t(purpose.paragraphTwo, 'America is shaped by millions of people, communities, industries, and experiences. No single subject can fully capture what is happening across the country, which is why we report across all of them.')}</p></div>
      <div class="pp-c"><div class="pp-ck">National to local</div><p data-tina-field={purpose ? tinaField(purpose, 'pullquote') : undefined}>{t(purpose.pullquote, 'We examine how national conversations connect with local realities and why each development matters to readers.')}</p></div>
    </div>
  </div></div></section>
  <section class="bh"><div class="w"><p class="acc-p" data-tina-field={standards ? tinaField(standards, 'intro') : undefined}>{t(standards.intro, 'America’s News Today exists for readers who want clear reporting, useful context, and a broader understanding of the stories shaping public life.')}</p></div></section>
  <section class="sec alt"><div class="w"><div class="cr">
    <div class="cr-l"><div class="sec-eye"><i></i><span data-tina-field={coverage ? tinaField(coverage, 'eyebrow') : undefined}>{t(coverage.eyebrow, 'What we cover')}</span></div><h2 class="h2" data-tina-field={coverage ? tinaField(coverage, 'title') : undefined}>{t(coverage.title, 'Coverage across the subjects that shape daily life')}</h2><p data-tina-field={coverage ? tinaField(coverage, 'intro') : undefined}>{t(coverage.intro, 'Our reporting spans the areas readers follow every day, from public affairs and business to culture, technology, education, environment, and lifestyle.')}</p></div>
    <div class="cg">{coverageItems.map((item:any, index:number)=><a class="crc" href={item.link || '#'}><div class="crc-a" data-tina-field={tinaField(item,'number')}>{item.number || String(index+1).padStart(2,'0')}</div><div class="crc-t" data-tina-field={tinaField(item,'title')}>{item.title}</div><p class="crc-x" data-tina-field={tinaField(item,'text')}>{item.text}</p></a>)}</div>
  </div></div></section>
  <section class="sec"><div class="w"><div class="sec-eye"><i></i><span data-tina-field={standards ? tinaField(standards, 'eyebrow') : undefined}>{t(standards.eyebrow, 'Standards')}</span></div><h2 class="h2" data-tina-field={standards ? tinaField(standards, 'title') : undefined}>{t(standards.title, 'How we work')}</h2><div class="st">{standardItems.map((item:any,index:number)=><div class="st-d"><div class="st-n" data-tina-field={tinaField(item,'number')}>{item.number || String(index+1).padStart(2,'0')}</div><div><div class="st-t" data-tina-field={tinaField(item,'title')}>{item.title}</div><p data-tina-field={tinaField(item,'text')}>{item.text}</p></div></div>)}</div></div></section>
  <section class="ind"><div class="w"><div class="ind-in"><div><div class="sec-eye"><i></i><span data-tina-field={independence ? tinaField(independence,'eyebrow') : undefined}>{t(independence.eyebrow,'Independence')}</span></div><h2 class="h2" data-tina-field={independence ? tinaField(independence,'title') : undefined}>{t(independence.title,'Independent reporting, accountable process')}</h2><p data-tina-field={independence ? tinaField(independence,'paragraphOne') : undefined}>{t(independence.paragraphOne,'We value accuracy, context, and clarity in every story we publish.')}</p><p data-tina-field={independence ? tinaField(independence,'paragraphTwo') : undefined}>{t(independence.paragraphTwo,'Corrections, updates, and reader feedback are treated as part of the public record.')}</p><a class="ind-cta" href={independence.buttonLink || '/editorial-guidelines/'} data-tina-field={independence ? tinaField(independence,'buttonText') : undefined}>{t(independence.buttonText,'Read our standards')}</a></div><div class="ind-st"><div class="ist"><div class="ist-n">01</div><div class="ist-l">Verify</div></div><div class="ist"><div class="ist-n">02</div><div class="ist-l">Explain</div></div><div class="ist"><div class="ist-n">03</div><div class="ist-l">Correct</div></div></div></div></div></section>
  <section class="cl"><div class="w"><h2 data-tina-field={newsroom ? tinaField(newsroom,'title') : undefined}>{t(newsroom.title,'Stay close to the stories shaping America.')}</h2><p data-tina-field={newsroom ? tinaField(newsroom,'intro') : undefined}>{t(newsroom.intro,'Visit us regularly for timely stories, practical information, and thoughtful coverage of the issues and ideas influencing America today.')}</p><a href="/" class="cl-cta">Read today’s stories</a></div></section>
</main>
