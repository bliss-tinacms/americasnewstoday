---
import { tinaField } from '@tinacms/astro/tina-field';
const { data = null, config = null } = Astro.props;
const block = Array.isArray(data?.blocks) ? data.blocks[0] : data;
const hero=block?.hero||{}; const formSection=block?.formSection||{}; const inboxes=block?.inboxes||{}; const requests=block?.requests||{};
const inboxCards=Array.isArray(inboxes?.cards)&&inboxes.cards.length?inboxes.cards:[]; const requestCards=Array.isArray(requests?.cards)&&requests.cards.length?requests.cards:[];
const formAction=formSection.formAction||config?.contactForm?.formspreeEndpoint||''; const t=(v:unknown,f='')=>String(v||f);
---
<main class="ffn-demo ffn-demo-contact">
  <header class="ph"><div class="w"><div class="ph-in"><div class="ph-kick"><i></i><span data-tina-field={hero ? tinaField(hero,'eyebrow') : undefined}>{t(hero.eyebrow,'Contact America’s News Today')}</span></div><h1 data-tina-field={hero ? tinaField(hero,'headline') : undefined}>{t(hero.headline,'Every message reaches a person in the newsroom.')}</h1><p data-tina-field={hero ? tinaField(hero,'lede') : undefined}>{t(hero.lede,'America’s News Today handles most correspondence through two addresses. Routing your message to the right one helps it reach the appropriate team faster.')}</p></div></div></header>
  <section class="ms"><div class="w"><div class="ms-in"><div><div class="eye"><i></i><span data-tina-field={formSection ? tinaField(formSection,'eyebrow') : undefined}>{t(formSection.eyebrow,'Send a message')}</span></div><h2 class="h2" data-tina-field={formSection ? tinaField(formSection,'title') : undefined}>{t(formSection.title,'Write to the Newsroom')}</h2><p class="ms-lead" data-tina-field={formSection ? tinaField(formSection,'description') : undefined}>{t(formSection.description,'Use this form for tips, pitches, corrections, or general correspondence. If your message is time sensitive, say so in the first line.')}</p><form method="POST" action={formAction || undefined}><div class="fg"><div><label class="fl" for="fn">Full Name</label><input class="fi" id="fn" name="full_name" type="text" placeholder="Your full name" /></div><div><label class="fl" for="fe">Email Address</label><input class="fi" id="fe" name="email" type="email" placeholder="your@email.com" /></div></div><div class="fr"><label class="fl" for="ft">Inquiry Type</label><select class="fi" id="ft" name="inquiry_type"><option>Story Tip</option><option>Correction Request</option><option>Contributor Inquiry</option><option>General Correspondence</option></select></div><div class="fr"><label class="fl" for="fm">Message</label><textarea class="fi" id="fm" name="message" placeholder="How can we help?"></textarea></div><p class="fnote" data-tina-field={formSection ? tinaField(formSection,'note') : undefined}>{t(formSection.note,'Fields marked * are required. Read during U.S. business hours.')}</p><button class="fsub" type="submit" data-tina-field={formSection ? tinaField(formSection,'buttonText') : undefined}>{t(formSection.buttonText,'Send message')}</button></form></div><aside class="sb"><div class="sb-t">Direct inboxes</div>{inboxCards.map((card:any)=><div class="sbr"><div class="sbr-k" data-tina-field={tinaField(card,'title')}>{card.title}</div><a class="sbr-v" href={`mailto:${card.email}`} data-tina-field={tinaField(card,'email')}>{card.email}</a><p class="sb-x" data-tina-field={tinaField(card,'description')}>{card.description}</p></div>)}</aside></div></div></section>
  <section class="nt"><div class="w"><div class="nt-l"><div class="eye"><i></i><span data-tina-field={requests ? tinaField(requests,'eyebrow') : undefined}>{t(requests.eyebrow,'Specific requests')}</span></div><h2 class="h2" data-tina-field={requests ? tinaField(requests,'title') : undefined}>{t(requests.title,'How to route your message')}</h2><p data-tina-field={requests ? tinaField(requests,'intro') : undefined}>{t(requests.intro,'Corrections, legal notices, and letters follow their own process.')}</p></div><div>{requestCards.map((card:any,index:number)=><article class="ntr"><div class="ntr-n">{String(index+1).padStart(2,'0')}</div><div><div class="ntr-t" data-tina-field={tinaField(card,'title')}>{card.title}</div><p class="ntr-x" data-tina-field={tinaField(card,'text')}>{card.text}</p></div></article>)}</div></div></section>
</main>
