---
import { getBlogPermalink, getBlogRouteSlug, getCategoryRouteSlug, getPageRouteSlug } from '../lib/permalinks';
import Base from '../layouts/Base.astro';
import BlogPost from '../layouts/BlogPost.astro';
import TinaIsland from '@tinacms/astro/TinaIsland.astro';
import PageBody from '../components/islands/PageBody.astro';
import BlogBody from '../components/islands/BlogBody.astro';
import CategoryArchiveHeader from '../components/islands/CategoryArchiveHeader.astro';
import DemoCategoryArchive from '../components/demo/DemoCategoryArchive.astro';
import DemoAuthorArchive from '../components/demo/DemoAuthorArchive.astro';
import Demo404 from '../components/demo/Demo404.astro';
import { getBlog, getCategory, getConfig, getPublicPage, getUser, listBlogs, listPages, type CmsBlog, type CmsCategory } from '../lib/data';
import { islands } from '../lib/islands';

export const prerender = false;

const POSTS_PER_PAGE = 30;
const routeSlug = (Astro.params.slug ?? '').toString().toLowerCase().replace(/^\/+|\/+$/g, '');
const localBlogModules = import.meta.glob('../content/blog/*.mdx', { eager: true });
const localUserModules = import.meta.glob('../content/user/*.json', { eager: true });
const localBlogFrontmatterByFilename = new Map(
  Object.entries(localBlogModules).map(([filePath, mod]) => {
    const filename = filePath.split('/').pop()?.replace(/\.mdx$/i, '') || '';
    const frontmatter = (mod as any).frontmatter || (mod as any).default?.frontmatter || {};
    return [filename, frontmatter];
  }).filter(([filename]) => filename)
);
const localUsersBySlug = new Map(
  Object.entries(localUserModules).map(([filePath, mod]) => {
    const filename = filePath.split('/').pop()?.replace(/\.json$/i, '') || '';
    const data = ((mod as any).default || mod || {}) as Record<string, any>;
    return [String(filename || data.name || data.title).toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/^-+|-+$/g, ''), { ...data, _sys: { filename } }];
  }).filter(([filename]) => filename)
);
const config = (await getConfig()).data?.config ?? null;
const allPages = await listPages();
const allPosts = (await listBlogs()).map(mergeLocalBlogFrontmatter);

type ReferenceObject = { title?: string | null; name?: string | null; _sys?: { filename?: string | null } | null; };

function slugify(value?: string | null) { return String(value || '').toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/^-+|-+$/g, ''); }
function titleCase(value?: string | null) { return String(value || '').replace(/[-_]+/g, ' ').replace(/\b\w/g, (char) => char.toUpperCase()).trim(); }
function labelFromReference(reference: unknown) {
  if (!reference) return null;
  if (Array.isArray(reference)) return reference.map(labelFromReference).filter(Boolean).join(', ') || null;
  if (typeof reference === 'string') return titleCase(reference.split('/').pop()?.replace(/\.(json|mdx?)$/i, '') || '');
  if (typeof reference === 'object') { const item = reference as ReferenceObject; return String(item.title || item.name || item._sys?.filename || '') || null; }
  return null;
}
function slugFromReference(reference: unknown) {
  if (!reference) return null;
  if (Array.isArray(reference)) return slugFromReference(reference[0]);
  if (typeof reference === 'string') return slugify(reference.split('/').pop()?.replace(/\.(json|mdx?)$/i, '') || '');
  if (typeof reference === 'object') { const item = reference as ReferenceObject; return slugify(item._sys?.filename || item.title || item.name || ''); }
  return null;
}
function slugsFromReference(reference: unknown) {
  return (Array.isArray(reference) ? reference : reference ? [reference] : [])
    .map(slugFromReference)
    .filter(Boolean) as string[];
}
function getReferenceKey(reference: unknown) {
  if (!reference) return null;
  if (Array.isArray(reference)) return getReferenceKey(reference[0]);
  if (typeof reference === 'string') return reference;
  if (typeof reference === 'object') {
    const item = reference as ReferenceObject;
    return item._sys?.filename || item.title || item.name || null;
  }
  return null;
}
function getReferenceKeys(reference: unknown) {
  return (Array.isArray(reference) ? reference : reference ? [reference] : [])
    .map(getReferenceKey)
    .filter(Boolean) as string[];
}
function findReferenceBySlug(reference: unknown, slug: string) {
  return (Array.isArray(reference) ? reference : reference ? [reference] : []).find((item) => slugFromReference(item) === slug) || null;
}
function getPostCategories(post: any) {
  const categories = post?.categories;
  if (Array.isArray(categories) && categories.length) return categories.map((item) => typeof item === 'string' ? item : item?.category).filter(Boolean);
  return post?.category;
}
function getPostAuthor(post: any) {
  return post?.author || post?.authorAlt || null;
}
function authorSlugsFromReference(reference: unknown) {
  const slugs = slugsFromReference(reference);
  if (slugs.length) return slugs;
  const label = labelFromReference(reference);
  return label ? [slugify(label)] : [];
}
function parseAuthorParam(value?: string) {
  const parts = String(value || '').toLowerCase().split('/').filter(Boolean);
  if (parts[0] !== 'author') return null;
  const pageIndex = parts.indexOf('page');
  const slug = parts.slice(1, pageIndex >= 0 ? pageIndex : undefined).join('/');
  if (!slug) return null;
  return { slug, page: pageIndex >= 0 ? Math.max(1, Number(parts[pageIndex + 1] || '1') || 1) : 1 };
}
function parseArchiveParam(value?: string) {
  const parts = String(value || '').toLowerCase().split('/').filter(Boolean);
  const pageIndex = parts.indexOf('page');
  if (pageIndex >= 0) return { slug: parts.slice(0, pageIndex).join('/'), page: Math.max(1, Number(parts[pageIndex + 1] || '1') || 1) };
  return { slug: parts.join('/'), page: 1 };
}
function pagePath(basePath: string, page: number) { return page <= 1 ? basePath + '/' : basePath + '/page/' + page + '/'; }
function getAuthorName(reference: unknown) { return labelFromReference(reference) || 'Americas News Today Staff'; }
function getPostUrl(post: CmsBlog) { const url = getBlogPermalink(post); return url.endsWith('/') ? url : url + '/'; }
function mergeLocalBlogFrontmatter(post: any) {
  const filename = post?._sys?.filename || '';
  const local = localBlogFrontmatterByFilename.get(filename) as Record<string, any> | undefined;
  if (!local) return post;
  const hasCategories = Array.isArray(post?.categories) && post.categories.length;
  const categories = hasCategories
    ? post.categories
    : (post?.category ? [post.category] : (local.category ? [local.category] : (Array.isArray(local.categories) ? local.categories : [])));
  return {
    ...local,
    ...post,
    categories,
    categoryLabel: labelFromReference(Array.isArray(categories) ? categories[0] : categories) || post?.categoryLabel,
    heroImage: post?.heroImage || local.heroImage,
    authorAlt: post?.authorAlt || local.authorAlt,
    description: post?.description || local.description,
    pubDate: post?.pubDate || local.pubDate,
    _sys: post?._sys || local._sys,
  };
}
function categoryFileMap() {
  const modules = import.meta.glob('../content/category/*.json', { eager: true });
  const map = new Map<string, { label: string; filename: string; data: CmsCategory | null }>();
  for (const [filePath, mod] of Object.entries(modules)) {
    const filename = filePath.split('/').pop()?.replace(/\.json$/i, '') || '';
    const data = ((mod as any).default || mod || {}) as CmsCategory;
    const label = String((data as any)?.title || (data as any)?.name || titleCase(filename));
    const slug = slugify(filename || label);
    if (slug) map.set(slug, { label, filename, data: { ...(data as any), _sys: { filename } } as CmsCategory });
  }
  return map;
}

const matchedPage = allPages.find((page) => getPageRouteSlug(page) === routeSlug || page._sys.filename === routeSlug);
let view: 'page' | 'category' | 'author' | 'blog' | 'not-found' = 'not-found';
let pageData: any = null;
let pageTitle = '';
let pageDescription = '';

let categoryContext: any = null;
let authorContext: any = null;
let blogContext: any = null;

if (matchedPage) {
  const documentSlug = matchedPage._sys.filename ?? routeSlug;
  const page = await getPublicPage(documentSlug);
  const data = page.data?.page;
  if (data) {
    const seo = data.seo ?? null;
    view = 'page';
    pageData = data;
    pageTitle = seo?.metaTitle || data.seoTitle || config?.seo?.title || 'Americas News Today';
    pageDescription = seo?.metaDescription || config?.seo?.description || 'Welcome to Americas News Today.';
  }
}

if (view === 'not-found') {
  const parsedAuthor = parseAuthorParam(routeSlug);
  if (parsedAuthor) {
    const localAuthor = localUsersBySlug.get(parsedAuthor.slug) || null;
    const editableAuthor = localAuthor?._sys?.filename ? (await getUser(localAuthor._sys.filename)).data?.user ?? null : null;
    const author = editableAuthor || localAuthor;
    if (author) {
      const allAuthorPosts = allPosts.filter((post) => authorSlugsFromReference(getPostAuthor(post)).includes(parsedAuthor.slug));
      const totalPages = Math.max(1, Math.ceil(allAuthorPosts.length / POSTS_PER_PAGE));
      const currentPage = Math.min(Math.max(1, parsedAuthor.page), totalPages);
      const posts = allAuthorPosts.slice((currentPage - 1) * POSTS_PER_PAGE, currentPage * POSTS_PER_PAGE);
      const authorName = author.name || titleCase(parsedAuthor.slug) || 'Author';
      const authorSeo = (author as any)?.seo || null;
      view = 'author';
      authorContext = {
        parsed: parsedAuthor,
        author,
        posts,
        totalPages,
        currentPage,
        basePath: '/author/' + parsedAuthor.slug,
        seo: authorSeo,
        seoTitle: authorSeo?.metaTitle || authorName + ' Articles | ' + (config?.seo?.title || 'Americas News Today'),
        description: authorSeo?.metaDescription || author.bio || (allAuthorPosts.length > 0 ? 'Read the latest articles by ' + authorName + ' from Americas News Today.' : 'Articles by ' + authorName + ' will be published soon on Americas News Today.'),
      };
    }
  }
}

if (view === 'not-found') {
  const parsed = parseArchiveParam(routeSlug);
  const categories = categoryFileMap();
  const categoryEntry = categories.get(parsed.slug);
  if (categoryEntry) {
    const allCategoryPosts = allPosts.filter((post) => slugsFromReference(getPostCategories(post)).includes(parsed.slug));
    const totalPages = Math.max(1, Math.ceil(allCategoryPosts.length / POSTS_PER_PAGE));
    const currentPage = Math.min(Math.max(1, parsed.page), totalPages);
    const posts = allCategoryPosts.slice((currentPage - 1) * POSTS_PER_PAGE, currentPage * POSTS_PER_PAGE);
    const editableCategory = (await getCategory(categoryEntry.filename || parsed.slug)).data?.category ?? null;
    const categoryFromPosts = editableCategory || (findReferenceBySlug(getPostCategories(allCategoryPosts[0]), parsed.slug) as CmsCategory | null) || categoryEntry.data;
    const archiveTitle = editableCategory?.title || labelFromReference(findReferenceBySlug(getPostCategories(allCategoryPosts[0]), parsed.slug)) || categoryEntry.label || titleCase(parsed.slug) || 'Category';
    const categorySeo = (editableCategory as any)?.seo || (categoryFromPosts as any)?.seo || (categoryEntry.data as any)?.seo || null;
    view = 'category';
    categoryContext = {
      parsed,
      posts,
      totalPages,
      currentPage,
      categoryFromPosts,
      archiveTitle,
      categoryDocumentSlug: categoryEntry.filename || categoryFromPosts?._sys?.filename || archiveTitle,
      basePath: '/' + parsed.slug,
      hasPosts: posts.length > 0,
      seo: categorySeo,
      seoTitle: categorySeo?.metaTitle || archiveTitle + ' Articles | ' + (config?.seo?.title || 'Americas News Today'),
      description: categorySeo?.metaDescription || editableCategory?.description || categoryEntry.data?.description || (allCategoryPosts.length > 0 ? 'Read the latest ' + archiveTitle + ' articles from Americas News Today.' : 'Articles in the ' + archiveTitle + ' category will be published soon on Americas News Today.'),
    };
  }
}

if (view === 'not-found') {
  const matchedPost = allPosts.find((post) => getBlogRouteSlug(post) === routeSlug || post._sys.filename === routeSlug);
  const documentSlug = matchedPost?._sys?.filename ?? routeSlug;
  const blog = await getBlog(documentSlug);
  const data = blog.data?.blog;
  if (data?.title || data?._sys?.filename) {
      const canonicalSlug = getBlogRouteSlug(data);
      if (canonicalSlug && canonicalSlug !== routeSlug) return Astro.redirect(getBlogPermalink(data) + '/', 301);
      const defaultAuthor = (await getUser('admin')).data?.user ?? null;
      const currentCategoryKeys = getReferenceKeys(getPostCategories(data));
      const relatedPosts = allPosts
        .filter((post) => post._sys.filename !== documentSlug)
        .filter((post) => getReferenceKeys(getPostCategories(post)).some((key) => currentCategoryKeys.includes(key)))
        .slice(0, 3);
      const seo = data.seo ?? null;
      const title = seo?.metaTitle || data.title || '';
      const description = seo?.metaDescription || data.description || '';
      view = 'blog';
      blogContext = {
        documentSlug,
        data,
        defaultAuthor,
        relatedPosts,
        layoutProps: {
          title,
          description,
          pubDate: data.pubDate ? new Date(data.pubDate) : new Date(),
          updatedDate: data.updatedDate ? new Date(data.updatedDate) : undefined,
          heroImage: seo?.ogImage || data.heroImage || null,
          ogTitle: seo?.ogTitle || title,
          ogDescription: seo?.ogDescription || description,
          canonicalUrl: seo?.canonicalUrl || getBlogPermalink(data) + '/',
          noindex: seo?.noindex || false,
          nofollow: seo?.nofollow || false,
        },
      };
    }
  }

if (view === 'not-found') {
  Astro.response.status = 404;
  pageTitle = '404 | Page Not Found | Americas News Today';
  pageDescription = 'The page you are looking for may have moved, been removed, or never existed.';
}
---

{view === 'not-found' && (
  <Base title={pageTitle} description={pageDescription} noindex={true}>
    <Demo404 posts={allPosts.slice(0, 3)} />
  </Base>
)}

{view === 'page' && pageData && (
  <Base
    title={pageTitle}
    description={pageDescription}
    image={pageData.seo?.ogImage || undefined}
    ogTitle={pageData.seo?.ogTitle || pageTitle}
    ogDescription={pageData.seo?.ogDescription || pageData.seo?.metaDescription || pageDescription}
    canonicalUrl={pageData.seo?.canonicalUrl || undefined}
    noindex={pageData.seo?.noindex || false}
    nofollow={pageData.seo?.nofollow || false}
  >
    <TinaIsland name="page" wrapper={islands.page.wrapper} params={{ slug: pageData._sys?.filename || routeSlug }} primary>
      <PageBody data={pageData} config={config} />
    </TinaIsland>
  </Base>
)}

{view === 'category' && categoryContext && (
  <Base
    title={categoryContext.seoTitle}
    description={categoryContext.description}
    image={categoryContext.seo?.ogImage || undefined}
    ogTitle={categoryContext.seo?.ogTitle || categoryContext.seoTitle}
    ogDescription={categoryContext.seo?.ogDescription || categoryContext.description}
    canonicalUrl={categoryContext.seo?.canonicalUrl || categoryContext.basePath + '/'}
    noindex={categoryContext.seo?.noindex || false}
    nofollow={categoryContext.seo?.nofollow || false}
  >
    <TinaIsland name="category" wrapper={islands.category.wrapper} params={{ slug: categoryContext.categoryDocumentSlug }} primary>
      <DemoCategoryArchive archiveTitle={categoryContext.archiveTitle} posts={categoryContext.posts} currentPage={categoryContext.currentPage} totalPages={categoryContext.totalPages} basePath={categoryContext.basePath} category={categoryContext.categoryFromPosts} />
    </TinaIsland>
  </Base>
)}

{view === 'author' && authorContext && (
  <Base
    title={authorContext.seoTitle}
    description={authorContext.description}
    image={authorContext.author?.avatar || undefined}
    ogTitle={authorContext.seo?.ogTitle || authorContext.seoTitle}
    ogDescription={authorContext.seo?.ogDescription || authorContext.description}
    canonicalUrl={authorContext.seo?.canonicalUrl || authorContext.basePath + '/'}
    noindex={authorContext.seo?.noindex || false}
    nofollow={authorContext.seo?.nofollow || false}
  >
    <DemoAuthorArchive author={authorContext.author} posts={authorContext.posts} currentPage={authorContext.currentPage} totalPages={authorContext.totalPages} basePath={authorContext.basePath} />
  </Base>
)}

{view === 'blog' && blogContext && (
  <BlogPost {...blogContext.layoutProps}>
    <TinaIsland name="blog" wrapper={islands.blog.wrapper} params={{ slug: blogContext.documentSlug }} primary>
      <BlogBody data={blogContext.data} relatedPosts={blogContext.relatedPosts} defaultAuthor={blogContext.defaultAuthor} />
    </TinaIsland>
  </BlogPost>
)}
